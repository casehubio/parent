  <version>0.2-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CaseHub Parent</name>
  <description>Org-level parent POM and BOM for casehubio projects</description>
  <url>https://github.com/casehubio/parent</url>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
