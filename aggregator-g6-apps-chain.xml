<?xml version="1.0" encoding="UTF-8"?>
<!--
  Group 6 — Chained Apps: have inter-app dependencies.
  Depends on G5 (life, iot). Ordering: ops needs iot, fsitrading needs ops.
  Other apps depend on life.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.casehub</groupId>
  <artifactId>casehub-aggregator-g6-apps-chain</artifactId>
  <version>0.3</version>
  <packaging>pom</packaging>

  <name>CaseHub :: G6 Chained Apps</name>

  <modules>
    <module>../devtown</module>
    <module>../aml</module>
    <module>../clinical</module>
    <module>../quarkmind</module>
    <module>../scaffold</module>
    <module>../ops</module>
    <module>../fsitrading</module>
  </modules>
</project>
